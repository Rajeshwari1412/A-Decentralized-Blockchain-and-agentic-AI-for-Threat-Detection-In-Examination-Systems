# ExamSentinel AI - Environment Configuration

# Application
PROJECT_NAME="ExamSentinel AI"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="examsentinel-super-secret-production-grade-jwt-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL with SQLite fallback)
# For Postgres: postgresql://postgres:postgres@localhost:5432/examsentinel
DATABASE_URL="sqlite:///./examsentinel.db"

# Blockchain Configuration (Hardhat / Local RPC / Sepolia)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
BLOCKCHAIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
ENABLE_MOCK_BLOCKCHAIN_FALLBACK=True

# ML & Threat Detection
ISOLATION_FOREST_CONTAMINATION=0.08
RISK_SCORE_THRESHOLD_LOW=30
RISK_SCORE_THRESHOLD_MEDIUM=60
RISK_SCORE_THRESHOLD_HIGH=80
AUTO_ALERT_THRESHOLD=65

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
